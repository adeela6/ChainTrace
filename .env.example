CHAINTRACE_ENV=development
DATABASE_URL=sqlite:///./chaintrace.db
STORAGE_DIR=./storage/evidence
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CHAINTRACE_MASTER_KEY=
